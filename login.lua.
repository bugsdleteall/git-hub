local function mkBox(ph, ypos)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -30, 0, 28)
    box.Position = UDim2.fromOffset(15, ypos)
    box.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
    box.BorderSizePixel = 0
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.TextColor3 = Color3.new(1, 1, 1)
    box.PlaceholderText = ph
    box.PlaceholderColor3 = Color3.fromRGB(110, 110, 120)
    box.Text = ""
    box.ClearTextOnFocus = false
    box.Parent = login
    return box
end

local userBox = mkBox("Usuário", 46)
local passBox = mkBox("Senha", 82)

local err = Instance.new("TextLabel", login)
err.Size = UDim2.new(1, -30, 0, 16)
err.Position = UDim2.fromOffset(15, 114)
err.BackgroundTransparency = 1
err.Font = Enum.Font.Gotham
err.TextSize = 11
err.TextColor3 = Color3.fromRGB(255, 80, 80)
err.Text = ""

local go = Instance.new("TextButton", login)
go.Size = UDim2.new(1, -30, 0, 30)
go.Position = UDim2.fromOffset(15, 136)
go.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
go.BorderSizePixel = 0
go.Font = Enum.Font.GothamBold
go.TextSize = 12
go.TextColor3 = Color3.new(1, 1, 1)
go.Text = "ENTRAR"

local function try()
    if userBox.Text == "403" and passBox.Text == "404" then
        login:Destroy()
        panel.Visible = true
    else
        err.Text = "Usuário ou senha incorretos"
        task.spawn(function()
            for _ = 1, 3 do
                login.Position = UDim2.new(0.5, -121, 0.5, -95); task.wait(0.05)
                login.Position = UDim2.new(0.5, -109, 0.5, -95); task.wait(0.05)
            end
            login.Position = UDim2.new(0.5, -115, 0.5, -95)
        end)
    end
end

go.MouseButton1Click:Connect(try)
userBox.FocusLost:Connect(function(e) if e then try() end end)
passBox.FocusLost:Connect(function(e) if e then try() end end)
